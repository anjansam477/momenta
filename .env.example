ENV=docker
NODE_ENV=development

PORT=8071
SERVICE_BASE_URL=http://localhost:8071
UI_BASE_URL=http://localhost:4200
NGINX_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

CONNECTION_STRING=mongodb://mongo_madness:27017/momenta?replicaSet=rs0
MONGODB_INITDB_ROOT_USERNAME=change-me
MONGODB_INITDB_ROOT_PASSWORD=change-me
DB_SCHEMA=momenta
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_BASEURL=mongo

REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

JWT_SECRET=change-me-long-random-value
DELIVERED_JWT_SECRET=change-me-long-random-value
SESSION_SECRET=change-me-long-random-value

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
DEFAULT_USER_PASS=change-me-long-random-value
GIPHY_API_KEY=change-me

MEDIA_FILE_PATH=./media-files
DISABLE_ACCESS_WHITELIST=false

EMAIL_APP_USER=change-me@gmail.com
EMAIL_APP_PASS=change-me-gmail-app-password
EMAIL_CONTACT_US=support@momenta.app

# Optional Kafka-backed notifications ("true" to enable; otherwise direct delivery)
ENABLE_KAFKA_NOTIFICATIONS=false
KAFKA_BROKER=kafka:9092

# Grafana admin login (used by docker-compose.prod.yml — no insecure default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
