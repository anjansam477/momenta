    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start backend",
            "request": "launch",
            "type": "node-terminal",
            "command": "cd backend && npm run dev",
            
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/backend/src/controllers/user-controller.js",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}