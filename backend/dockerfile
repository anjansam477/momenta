# ── Stage 1: install production dependencies ─────────────────────────────────
FROM node:20-slim AS deps
WORKDIR /backend
COPY package*.json ./
RUN npm ci --omit=dev

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM node:20-slim AS runtime
# NOTE: NODE_ENV is intentionally NOT baked in — the dev compose reuses this
# image and overrides the command, so production-only settings (secure cookies,
# fail-fast secrets) are set by docker-compose.prod.yml, not here.
ENV PORT=8071
WORKDIR /backend

# wget is used by the container HEALTHCHECK
RUN apt-get update \
  && apt-get install -y --no-install-recommends wget \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /backend/node_modules ./node_modules
COPY . .

# Run as the unprivileged "node" user that ships with the base image
RUN chown -R node:node /backend
USER node

EXPOSE 8071

# Liveness probe — hits the thin /health alias
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8071/health || exit 1

CMD ["node", "index.js"]
